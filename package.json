{
  "name": "algebra-solver",
  "version": "1.0.0",
  "description": "A zero-cost, Python-based algebra solver using Pyodide and SymPy with a modern Tailwind CSS UI",
  "main": "index.html",
  "scripts": {
    "build": "npm run build-css && npm run build-js",
    "build-css": "tailwindcss -i css/input.css -o css/output.css --minify",
    "build-js": "terser js/main.js js/solver.js --compress --mangle --output js/bundle.min.js",
    "watch": "tailwindcss -i css/input.css -o css/output.css --watch",
    "start": "python -m http.server 8000",
    "deploy": "wrangler pages deploy .",
    "postinstall": "npx update-browserslist-db@latest"
  },
  "keywords": [
    "algebra-solver",
    "tailwindcss",
    "pyodide",
    "cloudflare-pages",
    "social-media"
  ],
  "author": "Rumsfeld",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^4.1.4",
    "terser": "^5.39.0",
    "wrangler": "^4.14.0",
    "update-browserslist-db": "^1.1.3"
  },
  "optionalDependencies": {
    "pyodide": "0.27.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Build-1-0-0/algebra-solver.git"
  },
  "homepage": "https://algebra-solver.pages.dev"
}